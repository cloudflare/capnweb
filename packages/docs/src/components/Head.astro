---
/**
 * Adds the social card to Starlight's `<head>`.
 *
 * Starlight already emits `og:title`, `og:description`, `og:url` and
 * `twitter:card`; the image is the one piece it cannot know about, because it
 * is generated by `src/pages/og/[...slug].png.ts`.
 */
import Default from '@astrojs/starlight/components/Head.astro';

const { entry } = Astro.locals.starlightRoute;

// Mirrors the endpoint: the landing page's card is `index.png`.
const cardPath = `/og/${entry.id === '' ? 'index' : entry.id}.png`;

// Open Graph requires an absolute URL. `site` is only set when DOCS_SITE_URL
// is in the environment, so until the site has a canonical home this falls
// back to a root-relative path -- correct for anything that resolves it
// against the page, and inert for anything that does not.
const cardUrl = Astro.site ? new URL(cardPath, Astro.site).href : cardPath;

const heroTitle = entry.data.hero?.title;
const alt = `${heroTitle ?? entry.data.title} — Cap’n Web`;
---

<Default><slot /></Default>

<meta property="og:image" content={cardUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={alt} />
<meta name="twitter:image" content={cardUrl} />
<meta name="twitter:image:alt" content={alt} />
