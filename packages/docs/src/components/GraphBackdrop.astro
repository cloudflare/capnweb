---
/**
 * The node field behind the page, mounted once per document by the PageFrame override. It is fixed
 * to the viewport and sits behind everything, so it is seen through the margins around the content
 * sheet and through the sidebar.
 *
 * Splash pages have their own field behind the hero and are not given this one; the PageFrame
 * override decides that at build time, from frontmatter.
 */
import Constellation from './Constellation.astro';
---

<div class="cw-graph" aria-hidden="true">
	<Constellation variant="backdrop" />
</div>

<style>
	.cw-graph {
		position: fixed;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		pointer-events: none;
		/* Eased in on load so the field arrives with the page rather than snapping in after it. */
		animation: cw-graph-in 1s ease forwards;
		opacity: 0;
	}

	@keyframes cw-graph-in {
		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cw-graph {
			animation: none;
			opacity: 1;
		}
	}
</style>
