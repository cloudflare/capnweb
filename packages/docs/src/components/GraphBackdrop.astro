---
/**
 * The node field behind the page, mounted once per document by the PageFrame
 * override. It is fixed to the viewport and sits behind everything, so it is
 * seen through the margins around the content sheet and through the sidebar.
 *
 * Splash pages already have the WebGL hero and skip this one; see the guard in
 * the script below.
 */
---

<canvas class="cw-graph" data-state="idle" aria-hidden="true"></canvas>

<script>
	import { initGraphBackdrop } from '../scripts/graph-backdrop';

	const canvas = document.querySelector<HTMLCanvasElement>('.cw-graph');
	// The splash page paints its own field edge to edge; two of them would
	// fight, and the hero is the better one.
	if (canvas && !document.querySelector('main .hero')) {
		initGraphBackdrop(canvas);
	}
</script>

<style>
	.cw-graph {
		position: fixed;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		display: block;
		pointer-events: none;
		/* Held back until the first frame is on it, so there is no flicker of an
		   empty canvas over the ground gradient. */
		opacity: 0;
		transition: opacity 0.8s ease;
	}

	.cw-graph[data-state='ready'] {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.cw-graph {
			transition: none;
		}
	}
</style>
