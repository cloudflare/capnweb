---
/**
 * The body of a hero backdrop comparison page.
 *
 * Every variant route wants the identical page with one prop different, so the
 * page files under `src/pages/` are thin wrappers around this and there is only
 * one copy of the layout to keep correct. The hero itself comes from `Hero.astro`
 * with its `backdrop` slot filled and the copy imported from `lib/hero-copy.ts`,
 * so the headline, tagline, buttons and example windows are all the real landing
 * ones rather than a lookalike. That matters more than tidiness here: the
 * tagline's length decides the height of the box the scenes lay out against.
 *
 * There is deliberately no variant switcher on the page. One used to sit above
 * the hero, and it was useful while there were five of these to flick between,
 * but it is a strip of chrome the real landing page will never have, sitting in
 * the one position most likely to change how the hero below it reads. These are
 * judged by eye, so the page has to be the thing being judged and nothing else.
 * The routes are `/1` to `/9`; type them.
 *
 * `figure` mode is the exception, and it is a different page rather than a
 * different colour. The code windows come out, because the point of that variant
 * is that the animation carries the argument and two competing explanations of
 * the same idea stacked on top of each other is one too many. The backdrop keeps
 * only its stage and veil so the hero still has a floor to stand on.
 *
 * It also flips the hero's order to put the copy first. The landing leads with
 * the code windows and treats the headline as their caption, which works because
 * a static block of code is taken in at a glance. An animation is not: it has a
 * running time, and starting the page on one asks the reader to work out what
 * they are watching before they have been told why. Headline, then claim, then
 * the demonstration.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import HeroExample from "@/components/HeroExample.astro";
import bundleSize from "@/generated/bundle-size.json";
import { HERO_TITLE, heroTagline } from "@/lib/hero-copy";
import CanvasFigure from "./CanvasFigure.astro";
import CanvasHero from "./CanvasHero.astro";
import { sceneMeta, variantBySlug } from "./scenes";

interface Props {
  /** The route slug, e.g. `"1"` or `"1a"`. The scene and its opacity come from
      `VARIANTS`, so a page cannot pass a slug and a scene that disagree. */
  slug: string;
}

const { slug } = Astro.props;
const variant = variantBySlug(slug);
if (!variant) throw new Error(`HeroVariantPage: no variant "${slug}"`);
const { scene, opacity, mode = "backdrop", caption } = variant;
const meta = sceneMeta[scene];
const isFigure = mode === "figure";
// A figure with no caption is a picture with no alternative, so fail the build
// rather than ship one. `Variant` cannot express "caption required when mode is
// figure" without splitting the type, and this reads better than that would.
if (isFigure && !caption) throw new Error(`HeroVariantPage: "${slug}" is a figure with no caption`);
---

{/* `noindex`: a dozen near-duplicates of the landing copy are exactly what a
    search engine should not be offered. They are for looking at, not ranking. */}
<BaseLayout
  title={`${slug}. ${meta.title} \u00b7 hero backdrop`}
  description={meta.blurb}
  noindex
>
  <Header />
  <main id="main-content">
    <Hero
      title={HERO_TITLE}
      tagline={heroTagline(bundleSize.label)}
      illustration={isFigure ? "below" : "above"}
    >
      {
        isFigure ? (
          <CanvasHero slot="backdrop" />
        ) : (
          <CanvasHero slot="backdrop" scene={scene} opacity={opacity} />
        )
      }
      {isFigure ? <CanvasFigure scene={scene} caption={caption!} /> : <HeroExample />}
    </Hero>
  </main>
</BaseLayout>
