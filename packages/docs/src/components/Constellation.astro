---
/**
 * The node field: static geometry, animated only with properties the compositor can handle alone.
 *
 * This replaces a 2D canvas behind every page and a WebGL field behind the hero. Both redrew the
 * whole viewport every frame, which is how a documentation site ends up costing a core while
 * somebody reads it.
 *
 * The rule that shapes everything below is that **only `transform` and `opacity` on HTML elements
 * are animated**, because those are the two the compositor can run without waking the main thread.
 * Measured on this page, that is the difference between ~0% and several percent of a core:
 *
 * | Technique                          | Main thread |
 * | ---------------------------------- | ----------- |
 * | `transform` on HTML elements       | 0.1%        |
 * | `opacity` on HTML elements         | 0.0%        |
 * | `opacity` on SVG children          | 0.6%        |
 * | `stroke-dashoffset` on SVG lines   | 3.6%        |
 *
 * SVG was the obvious way to draw a graph and is the reason for the one piece of apparent
 * awkwardness here: edges are `<div>`s, rotated into place, rather than `<line>`s. The travelling
 * highlight that represents a message in flight then becomes a child element sliding along its
 * parent with `translateX`, which is free, instead of an animated dash, which is not.
 *
 * ## Why the geometry survives being resized
 *
 * The stage has a fixed `aspect-ratio` and is sized to cover its container. That makes the mapping
 * from authored coordinates to pixels a single uniform scale, so an angle computed at build time is
 * still correct at every window size and every zoom level. Percentages alone would not survive:
 * they resolve against width and height separately, so a rotated element would drift off its
 * endpoints as the window changed shape.
 *
 * ## Why there is no parallax
 *
 * There was, briefly: three groups drifting at three speeds. It is not compatible with a graph.
 * An edge is one element pinned at one end and rotated, so it can only stay attached to both of
 * its endpoints if all three move together -- and since the field is a single connected component
 * by construction, "all connected nodes share a transform" means the whole field is one transform
 * group. Anything else visibly tears the lines away from the dots, worst at the sizes where the
 * drift is largest relative to the spacing. Depth is carried by radius and brightness instead,
 * which is where most of it was coming from anyway.
 *
 * ## Why there is no hover response
 *
 * The old field lit up the node nearest the pointer and sent a pulse out and back along each of
 * its edges. That is gone, and it cannot be brought back in CSS alone.
 *
 * It was built here and measured before being removed: invisible hit circles over each node,
 * `pointer-events: auto` against a `pointer-events: none` parent, and one generated `:has()` rule
 * per node to light the node and the edges naming it as an endpoint. It works, and it is
 * unreachable. This field is painted behind the page, and CSS hit-testing has no way to express
 * "receive the pointer only where nothing is drawn over me" -- the topmost box wins whether or not
 * it painted anything. On a documentation page the content panel spans nearly the whole viewport,
 * so the backdrop is the topmost hit target on **1.3%** of it. Raising the hit layer above the
 * content fixes the hover and costs the page its text selection and some of its links, which is a
 * bad trade for decoration.
 *
 * Restoring it needs a `pointermove` listener that finds the nearest node and sets one class. That
 * is not a render loop -- it does nothing while the pointer is still, and the animation would stay
 * on the compositor -- but it is script, and the point of this rewrite was to have none.
 */
import { buildField, componentCount, type Options } from '../lib/constellation';

interface Props {
	variant: 'backdrop' | 'hero';
}

const { variant } = Astro.props;

// The hero is looked at directly, so it can afford to be denser. The backdrop is seen through the
// margins around a page of prose and should stay close to texture.
const presets: Record<Props['variant'], Options> = {
	backdrop: {
		seed: 20260209,
		width: 1400,
		height: 900,
		count: 46,
		reach: 260,
		maxDegree: 3,
		sparkCount: 5,
		twinkleCount: 14,
	},
	hero: {
		seed: 71177,
		width: 1200,
		height: 720,
		count: 64,
		reach: 215,
		maxDegree: 3,
		sparkCount: 7,
		twinkleCount: 18,
	},
};

const field = buildField(presets[variant]);
const aspect = field.width / field.height;

// A stranded dot is the one flaw in this thing that a reader notices and cannot explain, and it is
// invisible in a screenshot diff because it looks like an intentionally sparse corner. Fail the
// build instead of shipping it.
const components = componentCount(field);
if (components !== 1) {
	throw new Error(
		`Constellation "${variant}" is not connected: ${components} components across ` +
			`${field.nodes.length} nodes. Raise reach or maxDegree, or check the repair pass in ` +
			`src/lib/constellation.ts.`
	);
}

/** Authored units to a percentage of the stage. Uniform scale, so this holds at any size. */
const px = (value: number) => `${((value / field.width) * 100).toFixed(3)}%`;
const py = (value: number) => `${((value / field.height) * 100).toFixed(3)}%`;

const sparkFor = new Map(field.sparks.map((spark) => [spark.edge, spark]));

---

<div
	class:list={['cw-constellation', `cw-constellation-${variant}`]}
	aria-hidden="true"
	style={`--aspect: ${aspect.toFixed(4)};`}
>
	<div class="cw-stage">
		<div class="cw-field">
			{
				field.edges.map((edge) => {
					const angle = (Math.atan2(edge.y2 - edge.y1, edge.x2 - edge.x1) * 180) / Math.PI;
					const spark = sparkFor.get(edge);
					return (
						<div
							class="cw-edge"
							style={`left: ${px(edge.x1)}; top: ${py(edge.y1)}; width: ${px(edge.length)}; --angle: ${angle.toFixed(2)}deg; --depth: ${edge.depth};`}
						>
							{spark && (
								<div
									class="cw-spark"
									style={`--duration: ${spark.duration}s; --delay: ${spark.delay}s;`}
								/>
							)}
						</div>
					);
				})
			}
			{
				field.nodes.map((node) => (
					<div
						class:list={['cw-node', node.twinkleDuration > 0 && 'cw-twinkle']}
						style={`left: ${px(node.x)}; top: ${py(node.y)}; --size: ${node.radius * 2}px; --depth: ${node.depth}; --duration: ${node.twinkleDuration}s; --delay: ${node.twinkleDelay}s;`}
					/>
				))
			}
		</div>
	</div>
</div>

<style>
	.cw-constellation {
		position: absolute;
		inset: 0;
		overflow: hidden;
		/* Establishes the size container the stage measures itself against. */
		container-type: size;
	}

	/*
	 * Cover, in pure CSS. Taking the larger of "as wide as the container" and "as wide as the
	 * container is tall, times the aspect" guarantees both axes are filled, and the fixed
	 * `aspect-ratio` keeps the scale uniform so the baked-in angles stay true.
	 */
	.cw-stage {
		position: absolute;
		top: 50%;
		left: 50%;
		translate: -50% -50%;
		width: max(100cqw, calc(100cqh * var(--aspect)));
		aspect-ratio: var(--aspect);
	}

	/*
	 * The whole field drifts as one rigid body. One composited transform for the entire backdrop,
	 * and, because nothing moves relative to anything else, every line stays welded to the dots at
	 * both of its ends. The distance is small on purpose: it should read as breathing, not sliding.
	 */
	.cw-field {
		position: absolute;
		inset: 0;
		animation: cw-drift 71s ease-in-out infinite alternate;
	}

	@keyframes cw-drift {
		from {
			transform: translate3d(-7px, 5px, 0);
		}
		to {
			transform: translate3d(7px, -5px, 0);
		}
	}

	.cw-edge {
		position: absolute;
		height: 1px;
		transform: rotate(var(--angle));
		transform-origin: 0 50%;
		background-color: var(--cw-graph-edge);
		/* Depth decides how far back a line reads. The floor stops the far layer from vanishing
		   altogether, which looked like a bug rather than distance. */
		opacity: calc(var(--cw-graph-edge-alpha) * (0.45 + var(--depth) * 0.55));
	}

	.cw-node {
		position: absolute;
		width: var(--size);
		height: var(--size);
		margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
		border-radius: 50%;
		background-color: var(--cw-graph-node);
		opacity: calc(0.3 + var(--depth) * 0.42);
	}


	.cw-twinkle {
		animation: cw-twinkle var(--duration) ease-in-out infinite alternate;
		animation-delay: var(--delay);
	}

	@keyframes cw-twinkle {
		from {
			opacity: calc(0.22 + var(--depth) * 0.3);
		}
		to {
			opacity: calc(0.55 + var(--depth) * 0.45);
		}
	}

	/*
	 * A message crossing a connection: a short bright segment sliding from one end to the other.
	 * It is a child of the edge, so it inherits the rotation for free and only has to move along
	 * one axis. `translateX` on percentages of its own width is a compositor-only animation.
	 */
	.cw-spark {
		position: absolute;
		top: 50%;
		left: 0;
		/* One eighth of the edge, which makes the travel distance below exactly 700%: the
		   remaining 87.5% of the edge, expressed in multiples of the spark's own width. */
		width: 12.5%;
		height: 1.6px;
		margin-top: -0.8px;
		border-radius: 1px;
		opacity: 0;
		background: linear-gradient(90deg, transparent, var(--cw-graph-pulse));
		animation: cw-travel var(--duration) linear infinite;
		animation-delay: var(--delay);
		will-change: transform, opacity;
	}

	@keyframes cw-travel {
		0% {
			transform: translateX(0);
			opacity: 0;
		}
		10% {
			opacity: 0.9;
		}
		85% {
			opacity: 0.9;
		}
		100% {
			transform: translateX(700%);
			opacity: 0;
		}
	}

	.cw-constellation-hero .cw-node {
		opacity: calc(0.36 + var(--depth) * 0.46);
	}

	/*
	 * Motion is decoration. Removing it leaves the same field, drawn identically and standing
	 * still, which is the advantage of building it out of real geometry instead of a render loop.
	 */
	@media (prefers-reduced-motion: reduce) {
		.cw-constellation :is(.cw-field, .cw-node, .cw-edge, .cw-spark) {
			animation: none;
		}

		.cw-constellation .cw-spark {
			opacity: 0.55;
			transform: translateX(320%);
		}
	}
</style>
