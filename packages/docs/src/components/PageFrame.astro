---
/**
 * Override of Starlight's `PageFrame`, purely to mount the node field once per
 * document behind everything else.
 *
 * The frame itself is unchanged: this delegates to the stock component and
 * forwards its two named slots, so the header, the sidebar and the layout stay
 * upstream's problem rather than becoming ours.
 */
import StarlightPageFrame from '@astrojs/starlight/components/PageFrame.astro';
import GraphBackdrop from './GraphBackdrop.astro';
---

<GraphBackdrop />
<StarlightPageFrame>
	<slot name="header" slot="header" />
	<slot name="sidebar" slot="sidebar" />
	<slot />
</StarlightPageFrame>
