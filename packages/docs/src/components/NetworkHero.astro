---
/**
 * Full-bleed backdrop for the splash hero.
 *
 * This was a WebGL2 node field. It looked better than what replaced it and it cost a CPU core to
 * look at, which is not a trade a documentation site should be making. The field is now a static
 * SVG with a few CSS animations; the gradient and the veil below are unchanged, and they were
 * always the fallback, so the composition of the hero is the same.
 *
 * Purely decorative: `aria-hidden`, and carrying nothing that is not also in the hero copy.
 */
import Constellation from './Constellation.astro';
---

<div class="cw-hero-field" aria-hidden="true">
	<div class="cw-hero-stage">
		<Constellation variant="hero" />
	</div>
	<div class="cw-hero-veil"></div>
</div>

<style>
	.cw-hero-field {
		position: absolute;
		inset: 0 0 auto 0;
		/* Behind the hero's own copy, and behind whatever follows the hero on the
		   page: the field overhangs the section it lives in, and without this it
		   would paint over the top of the first paragraphs. */
		z-index: -1;
		/* Taller than the hero itself so the field is still going behind the
		   first band of prose, then taken out by the veil's mask. */
		height: min(46rem, 108vh);
		overflow: hidden;
		pointer-events: none;
		/* The fallback. Same geometry as the shader's gradient, so losing the
		   canvas changes the texture of the hero and not its composition. */
		background:
			radial-gradient(
				58rem 34rem at 68% 44%,
				var(--cw-hero-bg-inner) 0%,
				transparent 68%
			),
			var(--cw-hero-bg-outer);
	}

	.cw-hero-stage {
		display: block;
		width: 100%;
		height: 100%;
		/* Eased in so the field arrives with the page instead of snapping in. */
		opacity: 0;
		animation: cw-hero-in 0.9s ease forwards;
	}

	@keyframes cw-hero-in {
		to {
			opacity: 1;
		}
	}

	/* Dissolve the field into the page, and hold contrast under the copy. The
	   horizontal leg is skipped on narrow screens where text sits over the
	   middle of the canvas rather than to one side of it. */
	.cw-hero-veil {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			transparent 0%,
			transparent 52%,
			color-mix(in srgb, var(--cw-hero-bg-outer) 62%, transparent) 78%,
			var(--cw-hero-bg-outer) 100%
		);
	}

	@media (min-width: 50rem) {
		.cw-hero-veil {
			background:
				linear-gradient(
					90deg,
					color-mix(in srgb, var(--cw-hero-bg-outer) 94%, transparent) 0%,
					color-mix(in srgb, var(--cw-hero-bg-outer) 72%, transparent) 28%,
					color-mix(in srgb, var(--cw-hero-bg-outer) 28%, transparent) 50%,
					transparent 70%
				),
				linear-gradient(
					180deg,
					transparent 0%,
					transparent 52%,
					color-mix(in srgb, var(--cw-hero-bg-outer) 62%, transparent) 78%,
					var(--cw-hero-bg-outer) 100%
				);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cw-hero-stage {
			animation: none;
			opacity: 1;
		}
	}
</style>
