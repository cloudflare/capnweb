---
/**
 * Full-bleed backdrop for the splash hero.
 *
 * React Bits' LightTunnel, ported to vanilla JS + ogl. The tunnel is centred in
 * its own canvas so it reads as concentric rings / a loop, and that canvas is
 * parked in the top-right of the hero so the cables sweep in from the corner
 * while the copy on the left stays on the page background. A dark navy corner
 * backs it so the blue pulses glow. Decorative only: the canvas is aria-hidden,
 * pointer-events stay off, and reduced-motion visitors get the static corner.
 */
import LightTunnel from "./LightTunnel.astro";
---

<div class="cw-hero-field" aria-hidden="true">
  <div class="cw-hero-stage">
    <LightTunnel
      cableColor="#112039"
      pulseColor="#3B82F6"
      tunnelColor="#5227FF"
      tunnelOpacity={0}
      speed={0.1}
      flowDirection="inward"
      pulseSpeed={2}
      pulseLength={0.2}
      pulseBlend={0.8}
      pulseWidth={0.12}
      cableCount={44}
      thickness={0.5}
      rimWidth={0}
      waviness={0.6}
      sway={0.2}
      spiral={0.62}
      spinSpeed={0.02}
      size={1.5}
      centerX={0}
      centerY={0}
      glow={1.7}
      fadeNear={0.5}
      fadeFar={2.6}
      brightness={1.1}
      colorVariance
      grain
      grainIntensity={0.05}
      mouseInteraction={false}
    />
  </div>
  <div class="cw-hero-veil"></div>
</div>

<style>
  .cw-hero-field {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: -1;
    height: min(48rem, 112vh);
    overflow: hidden;
    pointer-events: none;
    /* The page background, with a soft pool centred behind the vortex that its
       rings glow against. */
    background:
      radial-gradient(
        60rem 52rem at 50% 42%,
        var(--cw-hero-stage-bg) 0%,
        color-mix(in srgb, var(--cw-hero-stage-bg) 40%, transparent) 40%,
        transparent 68%
      ),
      var(--nb-background);
  }

  /* The canvas is full-bleed so the vortex is never clipped by a container
     edge; its vanishing point is pushed to the top-right in the shader
     (centerX/centerY) so the spiral sits in the corner, clear of the copy. */
  .cw-hero-stage {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: cw-hero-in 1s ease forwards;
  }

  @keyframes cw-hero-in {
    to {
      opacity: 1;
    }
  }

  /* Reveal the vortex in the centre and dissolve its edges into the page, with
     a stronger fade at the bottom so it meets the copy below cleanly. */
  .cw-hero-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        78% 86% at 50% 42%,
        transparent 0%,
        transparent 46%,
        color-mix(in srgb, var(--nb-background) 50%, transparent) 72%,
        var(--nb-background) 96%
      ),
      linear-gradient(
        180deg,
        transparent 0%,
        transparent 64%,
        color-mix(in srgb, var(--nb-background) 60%, transparent) 84%,
        var(--nb-background) 100%
      );
  }

  @media (prefers-reduced-motion: reduce) {
    .cw-hero-stage {
      animation: none;
      opacity: 1;
    }
  }
</style>
