# Loaded by Vite only when running `astro dev`, so the landing page links to the
# examples running locally under `npm run dev` at the repo root rather than to
# the deployed subdomains. Ports here must match the root `dev:*` scripts.
#
# A production build ignores this file and uses the capnweb.com subdomains
# hard-coded as fallbacks in src/examples.ts.
PUBLIC_EXAMPLE_BATCH_PIPELINING_URL=http://127.0.0.1:8788
PUBLIC_EXAMPLE_WORKER_REACT_URL=http://127.0.0.1:8787
