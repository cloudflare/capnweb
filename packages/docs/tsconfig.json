{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  // `public/playground` is generated by scripts/build-playgrounds.mjs and
  // contains bundled third-party output; checking it is pure noise.
  "exclude": ["dist", "public/playground"]
}
